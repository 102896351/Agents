---
import Base from '../../layouts/Base.astro';
import AgentCard from '../../components/AgentCard.astro';
import InlineFigure from '../../components/InlineFigure.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { agents, categories } from '../../data/agents';
import { agentInlineImages } from '../../data/agent-inline-images';
import { agentVersions, VERSION_CHECKED, type AgentVersion } from '../../data/agent-versions';
import { getBlogSorted, getGuidesForAgent } from '../../data/blog';
import { topicTagsFor, topicLabel, TOPIC_BY_SLUG } from '../../data/taxonomy';
import { licenseLabel, difficultyLabel } from '../../utils/labels';

// 静态构建：getStaticPaths 把每个 agent 生成一个独立 HTML 页
export function getStaticPaths() {
  return agents.map((agent) => ({
    params: { slug: agent.slug },
    props: { agent },
  }));
}

const { agent } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cat = categories.find((c) => c.id === agent.category)!;
const site = (Astro.site ?? 'https://gonglue.xyz').toString().replace(/\/$/, '');
const canonical = `${site}/agent/${agent.slug}/`;

// Official screenshots that sit INSIDE the body copy, next to the section
// they illustrate. Profiles without a Sample section fall back to the
// Benchmarks or Pricing slot so no image is silently dropped.
// Real version snapshots from the GitHub API. Nothing here is invented:
// projects without a public release are labelled rolling / not published.
const ver: AgentVersion = agentVersions[agent.slug] ?? { kind: 'closed' };
const versionLabel = ver.version ?? (
  ver.kind === 'rolling' ? 'Rolling release'
  : ver.kind === 'unknown' ? 'Not verified'
  : 'Not published'
);
const releaseModelLabel =
  ver.kind === 'release' ? 'Versioned releases on GitHub'
  : ver.kind === 'tag' ? 'Git tags, no formal release notes'
  : ver.kind === 'rolling' ? 'Continuous / rolling main branch'
  : ver.kind === 'unknown' ? 'Upstream repository not reachable at check time'
  : 'Hosted product, no public version number';
const versionSentence =
  ver.kind === 'release' && ver.version
    ? `The latest published release we found is ${ver.version}${ver.released ? ` (${ver.released})` : ''}.`
    : ver.kind === 'tag' && ver.version
      ? `The latest git tag we found is ${ver.version}; this project does not publish formal release notes.`
      : ver.kind === 'rolling'
        ? 'We found no numbered release: this repository ships continuously from its main branch.'
        : ver.kind === 'unknown'
          ? 'We could not verify the public repository when we checked, so no version number is listed here.'
          : 'This product does not publish a public version number; it is distributed through its official site.';

const inlineImages = agentInlineImages[agent.slug] ?? [];
const quickFigures = inlineImages.filter((i) => i.section === 'quickstart');
const sampleFigures = inlineImages.filter((i) => i.section === 'sample');
const hasSampleSection = !!(agent.sampleInput || agent.sampleOutput);
const hasBenchSection = !!(agent.benchmarks && agent.benchmarks.length);
const hasQuickSection = !!(agent.quickStart && agent.quickStart.length);
const sampleSlot = hasSampleSection ? 'sample' : hasBenchSection ? 'benchmarks' : 'pricing';
const quickSlotFigures = hasQuickSection ? quickFigures : [];
const tailFigures = [
  ...(hasQuickSection ? [] : quickFigures),
  ...sampleFigures,
];
const allScreenshots = [
  ...(agent.image ? [agent.image.src] : []),
  ...inlineImages.map((i) => i.src),
];

// 相关推荐：同分类的其他 agent，最多 3 个（卡片区）
const related = agents
  .filter((a) => a.category === agent.category && a.slug !== agent.slug)
  .slice(0, 3);

// 替代品详情（用 slug 查找，去重 + 截断 4 个）
const altAgents = (agent.alternatives ?? [])
  .map((slug) => agents.find((a) => a.slug === slug))
  .filter(Boolean)
  .slice(0, 4) as typeof agents;

// Reverse internal links: long-form guides that discuss this agent.
const allPosts = getBlogSorted();
const guides = getGuidesForAgent(agent.slug, 6);

// Controlled topics: derive from the guides that mention this agent, then
// fall back to the category so even rarely-mentioned profiles get topic links.
const CATEGORY_TOPICS: Record<string, string[]> = {
  coding: ['coding', 'comparison', 'open-source'],
  research: ['research', 'ai-agents', 'data-rag'],
  browsing: ['automation', 'research', 'mcp-tooling'],
  automation: ['automation', 'mcp-tooling', 'business'],
  framework: ['frameworks', 'open-source', 'mcp-tooling'],
  creative: ['creative', 'business', 'ai-agents'],
};
const topics = [
  ...new Set([
    ...guides.flatMap((g) => topicTagsFor(g.tags, 4)),
    ...CATEGORY_TOPICS[agent.category],
  ]),
]
  .filter((t) => TOPIC_BY_SLUG[t])
  .slice(0, 4);

// Rotating peer window: every profile links to the 10 same-category agents
// that follow it alphabetically (wrapping around). This spreads inbound links
// evenly across all profiles instead of funnelling everything to the
// first three agents in each category.
const catRoster = agents
  .filter((a) => a.category === agent.category)
  .sort((a, b) => a.slug.localeCompare(b.slug));
const selfIdx = catRoster.findIndex((a) => a.slug === agent.slug);
const rotated = [...catRoster.slice(selfIdx + 1), ...catRoster.slice(0, selfIdx)];
const peers = rotated.slice(0, 10);

// Descriptive comparison links in the body copy (alternatives first, then peers).
const compareSlugs = [
  ...new Set([...altAgents.map((a) => a.slug), ...peers.slice(0, 4).map((a) => a.slug)]),
];
const compareTargets = compareSlugs
  .map((slug) => agents.find((a) => a.slug === slug))
  .filter(Boolean)
  .slice(0, 5) as typeof agents;

// Sidebar / footer navigation across the other five categories.
const otherCats = categories.filter((c) => c.id !== agent.category);

// Extra reading: guides on the same topics that were not already listed above.
const guideSlugs = new Set(guides.map((g) => g.slug));
const topicGuides = allPosts
  .filter((p) => !guideSlugs.has(p.slug))
  .map((p) => ({
    post: p,
    score: topicTagsFor(p.tags, 4).filter((t) => topics.includes(t)).length,
  }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || (a.post.date < b.post.date ? 1 : -1))
  .slice(0, 4)
  .map((x) => x.post);

const altNames = compareTargets.slice(0, 3).map((a) => a.name);
const comparePhrase =
  altNames.length > 1
    ? `${altNames.slice(0, -1).join(', ')} and ${altNames[altNames.length - 1]}`
    : altNames[0] ?? 'other agents in this category';

// FAQ derived only from fields this profile already has. No invented test
// results, no made-up recommendations.
const faqItems: { q: string; a: string }[] = [
  {
    q: `Is ${agent.name} free to use?`,
    a: `${agent.name} is listed as ${licenseLabel(agent.license).toLowerCase()}${agent.licenseName ? ` (${agent.licenseName})` : ''}. Pricing: ${agent.pricing} Plans, free tiers and model API costs change — check the official site linked above for current terms.`,
  },
];
if (agent.decisionAid?.pickIf) {
  faqItems.push({ q: `What is ${agent.name} best for?`, a: agent.decisionAid.pickIf });
}
if (agent.decisionAid?.skipIf) {
  faqItems.push({ q: `When should I skip ${agent.name}?`, a: agent.decisionAid.skipIf });
}
faqItems.push({
  q: `Can I self-host ${agent.name}?`,
  a: agent.selfHost
    ? `Yes — ${agent.name} is listed as self-hostable${agent.licenseName ? ` under ${agent.licenseName}` : ''}. Self-hosting means managing your own deployment, updates and model credentials.`
    : `No — ${agent.name} is currently listed as a hosted product with no self-hosting option. Check the official documentation in case that has changed.`,
});
if (compareTargets.length > 0) {
  faqItems.push({
    q: `What are the alternatives to ${agent.name}?`,
    a: `Other profiles on the same shortlist: ${compareTargets.map((a) => a.name).join(', ')}. The ${cat.label} category page lists every related agent with the same fields for comparison.`,
  });
}
faqItems.push({
  q: `Which version of ${agent.name} does this profile cover?`,
  a: `Version data for this profile was checked on ${VERSION_CHECKED}. ${versionSentence} Agent projects change quickly, so check the official repository or website linked at the top of this page for the current release before installing anything.`,
});
---

<Base title={agent.name} description={agent.tagline}>
  <!-- Per-page JSON-LD: SoftwareApplication + BreadcrumbList -->
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://www.schema.org',
      '@type': 'SoftwareApplication',
      name: agent.name,
      description: agent.description || agent.tagline,
      url: canonical,
      dateModified: VERSION_CHECKED,
      ...(ver.version ? { softwareVersion: ver.version } : {}),
      applicationCategory: cat.label,
      operatingSystem: 'Cross-platform',
      offers: {
        '@type': 'Offer',
        price: agent.license === 'open-source' ? '0' : undefined,
        priceCurrency: 'USD',
      },
      ...(agent.github ? { codeRepository: agent.github } : {}),
      ...(allScreenshots.length ? { screenshot: allScreenshots.map((s) => `${site}${s}`) } : {}),
      ...(agent.stars ? { interactionStatistic: {
        '@type': 'InteractionCounter',
        interactionType: 'https://schema.org/LikeAction',
        userInteractionCount: agent.stars,
      } } : {}),
    })}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: cat.label, item: `${site}/category/${cat.id}/` },
        { '@type': 'ListItem', position: 3, name: agent.name, item: canonical },
      ],
    })}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    })}
  />
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={`${base}/`}>Home</a><span aria-hidden="true">›</span>
      <a href={`${base}/category/${cat.id}/`}>{cat.label} agents</a><span aria-hidden="true">›</span>
      <span aria-current="page">{agent.name}</span>
    </nav>

    <div class="detail-head">
      <div style="margin: 18px 0 16px; display: flex; gap: 8px; flex-wrap: wrap;">
        <a class="pill active" href={`${base}/category/${cat.id}/`} style="text-decoration: none; color: inherit;">{cat.label}</a>
        <span class={`badge ${agent.license}`}>{licenseLabel(agent.license)}</span>
      </div>
      <h1>{agent.name}</h1>
      <p class="tagline">{agent.tagline}</p>

      <div class="agent-topics" aria-label="Topics">
        {topics.map((t) => (
          <a href={`${base}/blog/tags/${t}/`}>#{t}</a>
        ))}
      </div>

      <div class="detail-actions">
        <a href={agent.website} target="_blank" rel="noopener" class="btn primary">
          Visit website →
        </a>
        {agent.github && (
          <a href={agent.github} target="_blank" rel="noopener" class="btn">
            View on GitHub
          </a>
        )}
      </div>
    </div>

    <div class="detail-grid">
      <!-- 主内容 -->
      <div class="prose">
        <div class="verdict-box">
          <div class="label">Our take</div>
          <p style="margin: 0; color: var(--text);">{agent.verdict}</p>
        </div>

        <h2>What it is</h2>
        <p>
          {agent.description
            ? agent.description
            : `${agent.name} is a ${cat.label.toLowerCase()} agent. ${agent.tagline}`}
        </p>
        <p class="context-link">
          {agent.name} belongs to our <a href={`${base}/category/${cat.id}/`}>{cat.label} agents</a> collection.
          Compare it in the <a href={`${base}/blog/tags/comparison/`}>agent comparison guides</a> or browse the
          <a href={`${base}/`}>full directory</a> before choosing.
        </p>

        {agent.image && (
          <figure class="agent-figure agent-figure--inline">
            <p class="figure-note">What {agent.name} looks like in use — an official image from the project's own documentation.</p>
            <img
              src={`${base}${agent.image.src}`}
              alt={agent.image.alt}
              width={agent.image.width}
              height={agent.image.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              {agent.image.credit} ·{' '}
              <a href={agent.image.sourceUrl} target="_blank" rel="noopener">View upstream source</a>
            </figcaption>
          </figure>
        )}

        {agent.videos && agent.videos.length > 0 && (
          <section class="demo-section">
            <h2>See it in action</h2>
            <p class="figure-note">
              Demo clips pulled from the project's own documentation or official channel.
              We don't host these files — they play straight from the source.
            </p>
            <div class="video-grid">
              {agent.videos.map((v) => <VideoEmbed video={v} base={base} />)}
            </div>
          </section>
        )}

        {agent.useCases && agent.useCases.length > 0 && (
          <>
            <h2>Best for</h2>
            <ul class="usecase-list">
              {agent.useCases.map((uc) => <li>{uc}</li>)}
            </ul>
          </>
        )}

        {compareTargets.length > 0 && (
          <>
            <h2>How {agent.name} compares</h2>
            <p>
              The shortlist most readers weigh against {agent.name} includes {comparePhrase}.
              Profiles below cover setup, pricing and where each one breaks down:
            </p>
            <ul class="compare-list">
              {compareTargets.map((a) => (
                <li>
                  <a href={`${base}/agent/${a.slug}/`}>{a.name} vs {agent.name}</a>
                  <span> — {a.tagline}</span>
                </li>
              ))}
            </ul>
            <p class="context-link">
              See every <a href={`${base}/category/${cat.id}/`}>{cat.label} agent</a>, or read the{' '}
              <a href={`${base}/blog/tags/comparison/`}>comparison guides</a> and{' '}
              <a href={`${base}/blog/tags/${topics[0]}/`}>#{topics[0]} articles</a> for side-by-side verdicts.
            </p>
          </>
        )}

        {(agent.pros || agent.cons) && (
          <div class="pros-cons">
            {agent.pros && agent.pros.length > 0 && (
              <div class="pc-col pc-pros">
                <h3>Pros</h3>
                <ul>
                  {agent.pros.map((p) => <li>{p}</li>)}
                </ul>
              </div>
            )}
            {agent.cons && agent.cons.length > 0 && (
              <div class="pc-col pc-cons">
                <h3>Cons</h3>
                <ul>
                  {agent.cons.map((c) => <li>{c}</li>)}
                </ul>
              </div>
            )}
          </div>
        )}

        {agent.quickStart && agent.quickStart.length > 0 && (
          <>
            <h2>Quick start</h2>
            <ol class="quickstart-list">
              {agent.quickStart.map((step) => <li>{step}</li>)}
            </ol>
            {quickSlotFigures.map((img) => <InlineFigure image={img} base={base} />)}
          </>
        )}

        {(agent.sampleInput || agent.sampleOutput) && (
          <>
            <h2>Sample input / output</h2>
            <p class="data-note">Illustrative example — not a measured run. Shown to explain the workflow, not to report a result.</p>
            <div class="sample-io">
              {agent.sampleInput && (
                <div class="sample-block sample-in">
                  <div class="sample-label">Input</div>
                  <pre><code>{agent.sampleInput}</code></pre>
                </div>
              )}
              {agent.sampleOutput && (
                <div class="sample-block sample-out">
                  <div class="sample-label">Output</div>
                  <pre><code>{agent.sampleOutput}</code></pre>
                </div>
              )}
            </div>
            {sampleSlot === 'sample' && tailFigures.map((img) => <InlineFigure image={img} base={base} />)}
          </>
        )}

        {agent.benchmarks && agent.benchmarks.length > 0 && (
          <>
            <h2>Benchmarks</h2>
            <p class="data-note">Figures quoted from public sources; test conditions and dates vary. Verify against the original source before relying on a number.</p>
            <div class="bench-table">
              {agent.benchmarks.map((b) => (
                <div class="bench-row">
                  <span class="bench-k">{b.label}</span>
                  <span class="bench-v">{b.value}</span>
                  {b.source && <span class="bench-s">— {b.source}</span>}
                </div>
              ))}
            </div>
            {sampleSlot === 'benchmarks' && tailFigures.map((img) => <InlineFigure image={img} base={base} />)}
          </>
        )}

        <h2>Pricing</h2>
        <p>{agent.pricing}</p>
        {sampleSlot === 'pricing' && tailFigures.map((img) => <InlineFigure image={img} base={base} />)}

        <h2>Version and release status</h2>
        <p>
          This profile was compiled from public sources{ver.reviewed ? ` and its content was last reviewed in ${ver.reviewed}` : ''}.
          The version data below was checked on <strong>{VERSION_CHECKED}</strong>. Setup steps, pricing
          and screenshots above may describe an earlier release.
        </p>
        <div class="specs version-box">
          <div class="spec-row">
            <span class="k">Latest version</span>
            <span class="v">
              {ver.version && ver.source
                ? <><a href={ver.source} target="_blank" rel="noopener">{ver.version}</a>{ver.released ? ` · published ${ver.released}` : ''}</>
                : versionLabel}
            </span>
          </div>
          <div class="spec-row"><span class="k">Release model</span><span class="v">{releaseModelLabel}</span></div>
          {ver.pushed && (
            <div class="spec-row"><span class="k">Latest code activity</span><span class="v">{ver.pushed}</span></div>
          )}
          <div class="spec-row"><span class="k">Version data checked</span><span class="v">{VERSION_CHECKED}</span></div>
        </div>
        <p>
          {versionSentence} These projects ship frequently — use the official links at the top of
          this page to confirm the current release before installing.
        </p>

        {agent.models && agent.models.length > 0 && (
          <>
            <h2>Underlying models</h2>
            <div class="model-tags">
              {agent.models.map((m) => <span class="model-tag">{m}</span>)}
            </div>
          </>
        )}

        {agent.selfHost && (
          <>
            <h2>Self-hosting</h2>
            <p>
              Yes — {agent.name} can be self-hosted
              {agent.licenseName ? ` under the ${agent.licenseName} license` : ''}.
              This gives you full control over data and deployment. More self-hostable
              projects are collected under <a href={`${base}/blog/tags/open-source/`}>#open-source</a>.
            </p>
          </>
        )}

        {agent.decisionAid && (
          <div class="decision-aid">
            <h3>Should you pick this?</h3>
            <div class="da-row">
              <span class="da-tag da-pick">Pick it if</span>
              <span class="da-text">{agent.decisionAid.pickIf}</span>
            </div>
            <div class="da-row">
              <span class="da-tag da-skip">Skip it if</span>
              <span class="da-text">{agent.decisionAid.skipIf}</span>
            </div>
          </div>
        )}

        <h2>Frequently asked questions</h2>
        <div class="faq">
          {faqItems.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- 侧边栏：结构化规格 -->
      <aside>
        <div class="specs">
          <h3>At a glance</h3>
          <div class="spec-row">
            <span class="k">Category</span>
            <span class="v"><a href={`${base}/category/${cat.id}/`}>{cat.label}</a></span>
          </div>
          <div class="spec-row">
            <span class="k">License</span>
            <span class="v">
              {agent.license === 'open-source'
                ? <a href={`${base}/blog/tags/open-source/`}>{licenseLabel(agent.license)}</a>
                : licenseLabel(agent.license)}
            </span>
          </div>
          {agent.licenseName && (
            <div class="spec-row"><span class="k">License type</span><span class="v">{agent.licenseName}</span></div>
          )}
          <div class="spec-row">
            <span class="k">Self-host</span>
            <span class="v">{agent.selfHost ? 'Yes' : 'No'}</span>
          </div>
          <div class="spec-row">
            <span class="k">Difficulty</span>
            <span class="v">{difficultyLabel(agent.difficulty)}</span>
          </div>
          {agent.stars && agent.github && (
            <div class="spec-row">
              <span class="k">GitHub stars</span>
              <span class="v"><a href={agent.github} target="_blank" rel="noopener">★ {agent.stars.toLocaleString()}</a></span>
            </div>
          )}
          {agent.updated && (
            <div class="spec-row"><span class="k">Last updated</span><span class="v">{agent.updated}</span></div>
          )}
          <div class="spec-row">
            <span class="k">Version</span>
            <span class="v">
              {ver.version && ver.source
                ? <a href={ver.source} target="_blank" rel="noopener">{ver.version}</a>
                : versionLabel}
            </span>
          </div>
        </div>

        {altAgents.length > 0 && (
          <div class="alts">
            <h3>Alternatives</h3>
            {altAgents.map((a) => (
              <a href={`${base}/agent/${a.slug}/`} class="alt-link">
                <span class="alt-name">{a.name}</span>
                <span class="alt-arrow">→</span>
              </a>
            ))}
            <p class="side-note">
              All <a href={`${base}/category/${cat.id}/`}>{cat.label} agents</a> ·{' '}
              <a href={`${base}/blog/tags/comparison/`}>comparisons</a>
            </p>
          </div>
        )}

        <div class="side-cats">
          <h3>Browse by category</h3>
          {otherCats.map((c) => (
            <a href={`${base}/category/${c.id}/`}>{c.label} agents <span aria-hidden="true">→</span></a>
          ))}
          <p class="side-note"><a href={`${base}/`}>Full {agents.length}-agent directory</a></p>
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Similar agents</h2>
        </div>
        <div class="grid">
          {related.map((a) => <AgentCard agent={a} base={base} />)}
        </div>
      </section>
    )}

    {peers.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>More {cat.label} agents</h2>
          <p>
            Other profiles in <a href={`${base}/category/${cat.id}/`}>{cat.label}</a>,
            with pricing, setup notes and trade-offs for each.
          </p>
        </div>
        <nav class="inline-links" aria-label={`More ${cat.label} agents`}>
          <div class="inline-link-row">
            {peers.map((a) => (
              <a href={`${base}/agent/${a.slug}/`}>{a.name}</a>
            ))}
          </div>
        </nav>
      </section>
    )}

    {guides.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Guides mentioning {agent.name}</h2>
        </div>
        <div class="guide-links">
          {guides.map((g) => (
            <a href={`${base}/blog/${g.slug}/`}>
              <span>{g.title}</span>
              <span class="guide-meta">{g.readingTime} min read →</span>
            </a>
          ))}
        </div>
        <p class="guide-more">
          More comparisons in the <a href={`${base}/blog/`}>guide index</a> · all{' '}
          <a href={`${base}/category/${cat.id}/`}>{cat.label} agents</a>
        </p>
      </section>
    )}

    <section class="section">

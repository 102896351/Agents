---
import Base from '../layouts/Base.astro';
import AgentCard from '../components/AgentCard.astro';
import { agents, categories, getFeatured } from '../data/agents';
import { getBlogSorted } from '../data/blog';

const featured = getFeatured();
const postCount = getBlogSorted().length;
// The homepage is the only entry point visitors actually use, so give the
// guides a real distribution slot here instead of a single buried button.
const latestPosts = getBlogSorted().slice(0, 6);
const morePosts = getBlogSorted().slice(6, 9);
const shortTitle = (t: string) => (t.length > 62 ? t.slice(0, 59).trimEnd() + '\u2026' : t);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const codingCount = agents.filter((a) => a.category === 'coding').length;
const frameworkCount = agents.filter((a) => a.category === 'framework').length;
const catCounts: Record<string, number> = Object.fromEntries(
  categories.map((c) => [c.id, agents.filter((a) => a.category === c.id).length])
);
// Short, hand-written labels for the six spotlight cards only. These are
// deliberately two-to-three words, and the prices are condensed from the
// same pricing strings used on the full profile pages.
const spotlightNotes: Record<string, { bestFor: string; price: string }> = {
  'claude-code': { bestFor: 'Real-repo editing', price: 'Max $100+/mo' },
  cursor: { bestFor: 'Out-of-the-box IDE', price: 'Free · Pro $20/mo' },
  aider: { bestFor: 'Tidy git history', price: 'Free · BYO key' },
  cline: { bestFor: 'VS Code users', price: 'Free · BYO key' },
  'gemini-cli': { bestFor: 'Zero-cost start', price: 'Free tier' },
  opencode: { bestFor: 'Free & community', price: 'Free · BYO key' },
};
// The data files are appended in batches, so the tail really is "recently added".
const latest = agents.slice(-3).reverse();
const catLabel = (id: string) => categories.find((c) => c.id === id)?.label ?? id;
// One normalised haystack per card: name, tagline, tags, category and license.
// Hyphens become spaces so "open source" matches the "open-source" license.
const haystack = (a: (typeof agents)[number]) =>
  [a.name, a.tagline, a.tags.join(' '), catLabel(a.category), a.license]
    .join(' ')
    .toLowerCase()
    .replace(/[-_/]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
---

<Base>
  <section class="hero">
    <div class="container">
      <h1>Find the right <span class="grad">AI coding agent</span><br />for the job.</h1>
      <p>
        Structured, side-by-side profiles of {agents.length} AI agents — with coding tools up front.
        Compare pricing, license, setup and trade-offs without the marketing copy.
      </p>
      <div class="search-wrap" id="search-wrap">
        <div class="search-box">
          <svg class="search-icon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M13.5 13.5 18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <input
            type="text"
            id="search"
            placeholder={`Search ${agents.length} agents — try "terminal", "VS Code", "open source"…`}
            autocomplete="off"
            aria-label="Search agents"
            aria-controls="search-suggest"
            aria-expanded="false"
          />
          <button type="button" class="search-clear" id="search-clear" aria-label="Clear search" hidden>×</button>
          <kbd class="search-kbd" id="search-kbd" aria-hidden="true">/</kbd>
        </div>
        <p class="search-status" id="search-status" aria-live="polite"></p>
        <div class="search-suggest" id="search-suggest" role="listbox" aria-label="Matching agents" hidden></div>
      </div>
      <div class="hero-ctas">
        <a class="btn primary" href={`${base}/best-coding-agents/`}>Compare the 6 best coding agents →</a>
        <a class="btn" href="#categories">Browse all agents</a>
      </div>
      <div class="hero-meta">
        <span><b>{agents.length}</b> agents</span>
        <span><b>{codingCount}</b> coding agents</span>
        <span><b>{postCount}</b> comparison guides</span>
        <span>No paid placements</span>
      </div>
    </div>
  </section>

  <!-- Coding-first spotlight -->
  <section class="section" id="featured">
    <div class="container">
      <div class="section-head">
        <h2>Top coding agents</h2>
        <a class="section-more" href={`${base}/best-coding-agents/`}>Full comparison →</a>
      </div>
      <p class="section-sub">
        Six coding tools worth shortlisting. The short line tells you who each one is for.
      </p>
      <div class="spot-grid" id="featured-grid">
        {featured.map((agent) => (
          <AgentCard
            agent={agent}
            base={base}
            spotlight={true}
            bestFor={spotlightNotes[agent.slug]?.bestFor}
            price={spotlightNotes[agent.slug]?.price}
          />
        ))}
      </div>
      <div class="scenes">
        <a class="scene" href={`${base}/category/coding/`}>
          <span class="em">⌘</span>
          <div><b>All coding agents</b><span>{codingCount} profiles compared</span></div>
        </a>
        <a class="scene" href={`${base}/blog/tags/open-source/`}>
          <span class="em">◇</span>
          <div><b>Open source &amp; self-host</b><span>Guides and tagged profiles</span></div>
        </a>
        <a class="scene" href={`${base}/category/framework/`}>
          <span class="em">⌁</span>
          <div><b>Build your own agent</b><span>{frameworkCount} frameworks</span></div>
        </a>
        <a class="scene" href={`${base}/blog/tags/comparison/`}>
          <span class="em">⇄</span>
          <div><b>Head-to-head comparisons</b><span>Decision guides</span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- A second rhythm break: recently added, no invented "trending" numbers -->
  <section class="section" style="padding-top: 12px;">
    <div class="container">
      <div class="section-head">
        <h2>Recently added</h2>
        <a class="section-more" href="#categories">See all {agents.length} →</a>
      </div>
      <div class="trend-list">
        {latest.map((a, i) => (
          <a class="trend-item" href={`${base}/agent/${a.slug}/`}>
            <span class="rank">{i + 1}</span>
            <div><b>{a.name}</b><span>{a.tagline}</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest guides: real entry points into long-form content -->
  <section class="section guide-section" id="latest-guides">
    <div class="container">
      <div class="section-head">
        <h2>Latest guides</h2>
        <a class="section-more" href={`${base}/blog/`}>All {postCount} guides →</a>
      </div>
      <div class="guide-grid">
        {latestPosts.map((p) => (
          <a class="guide-card" href={`${base}/blog/${p.slug}/`}>
            {p.coverThumb && (
              <img src={p.coverThumb} alt="" width="600" height="335" loading="lazy" decoding="async" />
            )}
            <div class="guide-card-body">
              <time datetime={p.date}>
                {new Date(p.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
              <h3>{p.title}</h3>
              <p>{p.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
      <p class="guide-footnote">
        Prefer to watch first?{' '}
        <a href={`${base}/blog/official-agent-demo-videos-2026/`}>See the agents with official demo videos →</a>
      </p>
      <p class="guide-footnote">
        More from the guides:{' '}
        {morePosts.map((p) => (
          <a href={`${base}/blog/${p.slug}/`} style="margin-right: 14px;">{shortTitle(p.title)}</a>
        ))}
      </p>
      <p class="guide-footnote">
        Or browse by category:{' '}
        <a href={`${base}/category/coding/`}>coding agents</a> ·{' '}
        <a href={`${base}/category/framework/`}>agent frameworks</a> ·{' '}
        <a href={`${base}/category/research/`}>research agents</a>.
      </p>
    </div>
  </section>

  <!-- All agents, filterable; the filter bar sticks while scrolling -->
  <section class="section" id="categories">
    <div class="container">
      <div class="section-head">
        <h2>Browse all agents</h2>
        <span class="count" id="result-count">{agents.length} agents</span>
      </div>
    </div>
    <div class="filter-bar">
      <div class="container filter-in">
        <div class="pills" id="filter-pills">
          <button class="pill active" data-cat="all">All <span class="chip-count">{agents.length}</span></button>
          {categories.map((c) => (
            <button class="pill" data-cat={c.id}>{c.label} <span class="chip-count">{catCounts[c.id]}</span></button>
          ))}
        </div>
        <select id="sort" aria-label="Sort agents">
          <option value="default">Sort: directory order</option>
          <option value="stars">Sort: GitHub stars</option>
          <option value="az">Sort: A → Z</option>
          <option value="cat">Sort: category</option>
        </select>
      </div>
    </div>
    <div class="container">
      <div class="grid" id="agent-grid">
        {agents.map((agent, i) => (
          <div class="card-wrap"
               data-name={agent.name.toLowerCase()}
               data-cat={agent.category}
               data-tags={agent.tags.join(' ')}
               data-slug={agent.slug}
               data-tagline={agent.tagline}
               data-haystack={haystack(agent)}
               data-stars={agent.stars ?? 0}
               data-order={i}>
            <AgentCard agent={agent} base={base} />
          </div>
        ))}
      </div>
      <p class="empty hidden" id="empty-state">No agents match your search.</p>
    </div>
  </section>

  <!-- Bookmark: browser-native save. No fake email form, no app, no backend. -->
  <section class="section" style="padding-top: 8px;">
    <div class="container">
      <div class="subscribe">
        <div>
          <h3>Keep this directory handy</h3>
          <p>Save this page in your browser bookmarks. No account, no email, no app needed.</p>
        </div>
        <div class="sub-actions">
          <details class="bookmark-tip">
            <summary class="btn primary">Add to bookmarks</summary>
            <div class="bookmark-tip-body">
              <p>Your browser saves bookmarks itself, so just press:</p>
              <p class="bookmark-keys"><kbd>Ctrl</kbd> + <kbd>D</kbd> on Windows &middot; <kbd>&#8984;</kbd> + <kbd>D</kbd> on Mac</p>
              <p>Or click the star in the address bar, then choose a folder to save it in.</p>
            </div>
          </details>
          <a class="btn" href={`${base}/blog/`}>All guides</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Honest project framing, kept but moved below the directory -->
  <section class="section section-editorial" aria-label="About this directory">
    <div class="container">
      <div class="editorial-intro">
        <p class="editorial-lead">
          <strong>AI Agents Hub is an open-source directory built by an independent developer.</strong>
          Every agent gets the same structured profile — what it does, license, pricing,
          strengths, and a direct "pick this if / skip this if" verdict — so {agents.length}
          tools can be compared side by side.
        </p>
        <p class="editorial-detail">
          Profiles are compiled from public sources (official docs, GitHub repositories,
          release notes and pricing pages) into a consistent set of fields. Verdicts are
          the maintainer's judgement, not measured test results; sample inputs and outputs
          are illustrative, and benchmark numbers should be checked against the original
          source. No paid placements. The data is public — corrections and new entries
          can be submitted as an issue or pull request on
          <a href="https://github.com/102896351/Agents" target="_blank" rel="noopener">GitHub</a>.
        </p>
        <p class="editorial-meta">
          {agents.length} agents across {categories.length} categories ·
          {postCount} comparison guides · Open data on
          <a href="https://github.com/102896351/Agents" target="_blank" rel="noopener">GitHub</a> ·
          <a href="/about/">How this site is built</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Browse by category: internal links to per-category landing pages -->
  <section class="section" id="browse-categories">
    <div class="container">
      <div class="section-head">
        <h2>Browse by category</h2>
        <span class="count">{categories.length} categories</span>
      </div>
      <div class="pills">
        {categories.map((c) => (
          <a class="pill" href={`${base}/category/${c.id}/`}>{c.label} <span class="chip-count">{catCounts[c.id]}</span></a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .guide-section { padding-top: 12px; }
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }
  .guide-card {
    display: block;
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 14px;
    text-decoration: none;
    transition: border-color .18s ease, transform .18s ease;
  }
  .guide-card:hover { border-color: #818cf8; transform: translateY(-2px); }
  .guide-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 600 / 335;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .guide-card-body { padding: 16px 18px 20px; }
  .guide-card-body time { font-size: 12px; color: var(--text-muted); }
  .guide-card-body h3 {
    margin: 8px 0 8px;
    font-size: 17px;
    line-height: 1.4;
    color: var(--text);
  }
  .guide-card-body p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .guide-footnote {
    margin: 16px 0 0;
    font-size: 13.5px;
    color: var(--text-muted);
  }
  .guide-footnote a { color: #818cf8; }
  .section-editorial { padding: 16px 0 24px; }
  .editorial-intro {
    max-width: 760px;
    margin: 0 auto;
    text-align: left;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 28px 32px;
  }
  .editorial-lead { font-size: 18px; line-height: 1.6; color: var(--text); margin: 0 0 12px; }
  .editorial-detail { font-size: 15px; line-height: 1.65; color: var(--text-muted); margin: 0 0 12px; }
  .editorial-meta { font-size: 13px; color: var(--text-muted); margin: 0; }
  .editorial-meta a { color: #818cf8; text-decoration: underline; text-underline-offset: 2px; }
</style>

<script is:inline>
  (function () {
    const pills = document.querySelectorAll('#filter-pills .pill');
    const cardEls = Array.from(document.querySelectorAll('#agent-grid .card-wrap'));
    const search = document.getElementById('search');
    const searchWrap = document.getElementById('search-wrap');
    const clearBtn = document.getElementById('search-clear');
    const kbd = document.getElementById('search-kbd');
    const status = document.getElementById('search-status');
    const suggest = document.getElementById('search-suggest');
    const empty = document.getElementById('empty-state');
    const count = document.getElementById('result-count');
    const sortSel = document.getElementById('sort');
    const grid = document.getElementById('agent-grid');

    const norm = (s) => (s || '').toLowerCase().replace(/[-_/]+/g, ' ').replace(/\s+/g, ' ').trim();
    const tokensOf = (q) => norm(q).split(' ').filter(Boolean);

    // Read the search index straight from the rendered cards — no duplicate data.
    const records = cardEls.map((el) => {
      const link = el.querySelector('a.card');
      const title = el.querySelector('h3');
      return {
        el,
        name: title ? title.textContent.trim() : (el.dataset.name || ''),
        cat: el.dataset.cat || '',
        tagline: el.dataset.tagline || '',
        hay: el.dataset.haystack || norm(el.dataset.name || ''),
        href: link ? link.getAttribute('href') : '#',
      };
    });

    let currentCat = 'all';
    let currentQuery = '';
    let activeIndex = -1;

    function apply() {
      const tokens = tokensOf(currentQuery);
      let visible = 0;
      const found = [];
      records.forEach((rec) => {
        const matchCat = currentCat === 'all' || rec.cat === currentCat;
        const matchQ = tokens.length === 0 || tokens.every((t) => rec.hay.includes(t));
        const show = matchCat && matchQ;
        rec.el.classList.toggle('hidden', !show);
        if (show) {
          visible++;
          if (tokens.length) found.push(rec);
        }
      });
      if (count) count.textContent = `${visible} ${visible === 1 ? 'agent' : 'agents'}`;
      if (empty) empty.classList.toggle('hidden', visible !== 0);
      return { visible, found, tokens };
    }

    function jumpToResults() {
      suggest.hidden = true;
      search.setAttribute('aria-expanded', 'false');
      const target = document.getElementById('categories');
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function renderStatus(visible, tokens) {
      status.replaceChildren();
      if (!tokens.length) {
        status.classList.remove('on');
        clearBtn.hidden = true;
        kbd.hidden = false;
        return;
      }
      status.classList.add('on');
      clearBtn.hidden = false;
      kbd.hidden = true;
      status.appendChild(document.createTextNode(visible + ' of ' + records.length + ' agents match · '));
      const a = document.createElement('a');
      a.href = '#categories';
      a.textContent = 'Jump to results ↓';
      a.addEventListener('click', (e) => { e.preventDefault(); jumpToResults(); });
      status.appendChild(a);
    }

    function renderSuggest(found, tokens) {
      suggest.replaceChildren();
      activeIndex = -1;
      if (!tokens.length) {
        suggest.hidden = true;
        search.setAttribute('aria-expanded', 'false');
        return;
      }
      const top = found.slice(0, 6);
      if (!top.length) {
        const d = document.createElement('div');
        d.className = 'suggest-empty';
        d.textContent = 'No agent matches that keyword. Try a shorter word.';
        suggest.appendChild(d);
      } else {
        top.forEach((rec) => {
          const a = document.createElement('a');
          a.className = 'suggest-item';
          a.href = rec.href;
          const b = document.createElement('b');
          b.textContent = rec.name;
          const s = document.createElement('span');
          s.textContent = rec.tagline;
          a.appendChild(b);
          a.appendChild(s);
          suggest.appendChild(a);
        });
      }
      if (found.length) {
        const more = document.createElement('button');
        more.type = 'button';
        more.className = 'suggest-all';
        more.textContent = 'View all ' + found.length + ' matching agents ↓';
        more.addEventListener('click', jumpToResults);
        suggest.appendChild(more);
      }
      suggest.hidden = false;
      search.setAttribute('aria-expanded', 'true');
    }

    function refresh() {
      const r = apply();
      renderStatus(r.visible, r.tokens);
      renderSuggest(r.found, r.tokens);
    }

    function clearSearch(keepFocus) {
      search.value = '';
      currentQuery = '';
      refresh();
      if (keepFocus !== false) search.focus();
    }

    const items = () => Array.from(suggest.querySelectorAll('.suggest-item'));
    function setActive(i) {
      const list = items();
      if (!list.length) return;
      activeIndex = (i + list.length) % list.length;
      list.forEach((el, j) => el.classList.toggle('active', j === activeIndex));
    }

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        currentCat = pill.dataset.cat || 'all';
        refresh();
      });
    });

    search.addEventListener('input', () => { currentQuery = search.value; refresh(); });
    search.addEventListener('focus', () => { if (tokensOf(search.value).length) refresh(); });
    search.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (suggest.hidden) refresh();
        setActive(activeIndex + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(activeIndex - 1);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const list = items();
        if (!suggest.hidden && activeIndex >= 0 && list[activeIndex]) {
          window.location.href = list[activeIndex].href;
        } else {
          jumpToResults();
        }
      } else if (e.key === 'Escape') {
        clearSearch(false);
        search.blur();
      }
    });

    clearBtn.addEventListener('click', () => clearSearch(true));

    document.addEventListener('keydown', (e) => {
      const tag = (document.activeElement || {}).tagName;
      if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA' && tag !== 'SELECT') {
        e.preventDefault();
        search.focus();
        search.select();
      }
    });

    document.addEventListener('click', (e) => {
      if (!searchWrap.contains(e.target)) {
        suggest.hidden = true;
        search.setAttribute('aria-expanded', 'false');
      }
    });

    if (sortSel && grid) {
      sortSel.addEventListener('change', () => {
        const mode = sortSel.value;
        const ordered = Array.from(cardEls).sort((a, b) => {
          if (mode === 'stars') return (Number(b.dataset.stars) || 0) - (Number(a.dataset.stars) || 0);
          if (mode === 'az') return (a.dataset.name || '').localeCompare(b.dataset.name || '');
          if (mode === 'cat') return (a.dataset.cat || '').localeCompare(b.dataset.cat || '') || (a.dataset.name || '').localeCompare(b.dataset.name || '');
          return (Number(a.dataset.order) || 0) - (Number(b.dataset.order) || 0);
        });
        ordered.forEach((el) => grid.appendChild(el));
      });
    }

    refresh();
  })();
</script>

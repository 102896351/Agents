---
import Base from '../layouts/Base.astro';

const REPO = 'https://github.com/102896351/Agents';
const EMAIL = 'yangkunming2026@gmail.com';
const mailto = (subject: string, body: string) =>
  `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
const suggestionUrl = mailto('[Suggestion] new agent', [
  'Agent name + one-line positioning:',
  '',
  'Homepage / GitHub link:',
  '',
  'License type (open source / commercial / freemium):',
  '',
  'One sentence on why it deserves a spot:',
  '',
  '---',
  'Sent from the suggestion link on https://gonglue.xyz/contact/.',
].join('\r\n'));
const enc = (s: string) => encodeURIComponent(s);
const mainMailData = enc('mailto:' + EMAIL);
const emailTextData = enc(EMAIL);
const suggestionData = enc(suggestionUrl);
---

<Base title="Contact" description="Suggest an agent or send a pull request. AI Agents Hub is a one-developer open-source project.">
  <section class="hero" style="padding-top: 80px; padding-bottom: 24px;">
    <div class="container">
      <h1>Contact</h1>
      <p>Want to suggest an agent or fix a stale number? Email is the quickest route, and pull requests on GitHub are welcome too.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 640px;">
      <div class="contact-simple">
        <div class="contact-label">Contribute code or data</div>
        <a class="contact-mail" href={REPO} target="_blank" rel="noopener">github.com/102896351/Agents</a>
        <p class="contact-hint">Every agent profile lives in <code>src/data/agents.ts</code> and the related data files. A pull request is optional — the change history is public. For anything else, use the email link below.</p>
      </div>

      <div class="contact-simple" style="margin-top: 24px;">
        <div class="contact-label">Email — the main channel</div>
        <a class="contact-mail" href="#" data-mail={mainMailData}><span data-email-text={emailTextData}>Email the site owner</span></a>
        <p class="contact-hint">General messages go to this one inbox. The link below opens your own mail app with a short checklist already filled in — nothing is stored on this site.</p>
        <div class="contact-actions">
          <a href="#" data-mail={suggestionData}>Suggest an agent</a>
        </div>
      </div>

      <div class="prose" style="margin-top: 48px;">
        <h2>When to reach out</h2>
        <ul>
          <li><strong>Missing an agent?</strong> Send the homepage / GitHub link, or open a pull request against the data file (usually faster).</li>
          <li><strong>Spotted stale info</strong> (star count, pricing, status, etc.)? Point it out with a source link and it will be corrected.</li>
          <li><strong>Business / partnership</strong> (brand collaboration, content syndication, API data partnerships).</li>
          <li><strong>Found a bug on the site itself</strong> (not a problem with any listed agent).</li>
          <li><strong>Have something to say</strong> — any thoughts, suggestions, or honest criticism about the AI agent space are welcome.</li>
        </ul>

        <h2>Submission checklist (new agent)</h2>
        <p>To make a listing easy to add, please include:</p>
        <ul>
          <li>Agent name + a one-line positioning</li>
          <li>Homepage / GitHub link</li>
          <li>License type (open source / commercial / freemium)</li>
          <li>One sentence on why it deserves a spot</li>
        </ul>
        <p>
          Pull requests are reviewed in the open. There is no promised turnaround,
          and this project does not guarantee that every suggestion will be published.
        </p>

        <h2>What we usually don't reply to</h2>
        <p>To keep the inbox usable, these are typically skipped:</p>
        <ul>
          <li>SEO link exchanges / bulk backlink requests</li>
          <li>Unsolicited "exclusive interview" or guest invitations</li>
          <li>Promotions unrelated to the AI agent topic</li>
        </ul>
        <p>If that sounds like your request, apologies in advance — and thanks for understanding.</p>

        <h2>Privacy</h2>
        <p>
          Your email is used only for this conversation. It will not be added to any
          mailing list or shared with third parties. To delete previous correspondence,
          simply reply with "please delete my email." Full details are in the
          <a href="/privacy/">privacy policy</a>.
        </p>

        <div class="verdict-box" style="margin-top: 24px;">
          <div class="label">About response times</div>
          <p style="margin: 0; color: var(--text);">
            This is a one-person side project. No response time is promised. Email
            is the main channel; a public pull request on GitHub is optional and
            makes the change history visible.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
  }
  .contact-actions a {
    padding: 8px 16px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration: none;
  }
  .contact-actions a:hover { border-color: #818cf8; color: #818cf8; }
</style>

---
import Base from '../../layouts/Base.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { getBlogSorted, getRelatedPosts, type BlogPost } from '../../data/blog';
import { agents, categories } from '../../data/agents';
import { topicTagsFor } from '../../data/taxonomy';
import { VERSION_CHECKED } from '../../data/agent-versions';

export async function getStaticPaths() {
  return getBlogSorted().map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props { post: BlogPost }
const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const related = getRelatedPosts(post.slug, 3);
const canonical = new URL(`${base}/blog/${post.slug}/`, Astro.site ?? 'https://gonglue.xyz').toString();

// Controlled topic chips + the agent profiles this guide actually discusses.
const topics = topicTagsFor(post.tags, 4);
const linkedAgents = post.relatedAgents
  .map((slug) => agents.find((a) => a.slug === slug))
  .filter(Boolean)
  .slice(0, 6) as typeof agents;
const primaryCat =
  categories.find((c) => linkedAgents.some((a) => a.category === c.id)) ?? categories[0];
---

<Base title={post.title} description={post.excerpt}>
  <!-- SEO: BlogPosting JSON-LD -->
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.title,
      description: post.excerpt,
      datePublished: post.date,
      dateModified: post.date,
      author: {
        '@type': 'Organization',
        name: 'AI Agents Hub',
        url: 'https://gonglue.xyz/about/',
      },
      publisher: { '@type': 'Organization', name: 'AI Agents Hub', url: 'https://gonglue.xyz/' },
      mainEntityOfPage: canonical,
      url: canonical,
      keywords: [...new Set([...topics, ...post.tags])].join(', '),
    })}
  />

  <article class="post">
    <div class="container">
      <header class="post-header">
        <a href={`${base}/blog/`} class="back-link">← Back to Blog</a>
        <h1>{post.title}</h1>
        <p class="post-excerpt">{post.excerpt}</p>
        <div class="post-meta">
          <span>{post.author}</span>
          <span class="dot">·</span>
          <time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          <span class="dot">·</span>
          <span>{post.readingTime} min read</span>
        </div>
        <div class="post-topics" aria-label="Topics">
          {topics.map((t) => (
            <a href={`${base}/blog/tags/${t}/`}>#{t}</a>
          ))}
        </div>
        <p class="post-context">
          Part of our <a href={`${base}/blog/`}>agent guides</a> · Browse all{' '}
          <a href={`${base}/category/${primaryCat.id}/`}>{primaryCat.label} agents</a> or the{' '}
          <a href={`${base}/`}>full directory</a>.
        </p>
      </header>

      {post.coverThumb && (
        <figure class="post-hero-figure">
          <img
            src={post.coverThumb}
            alt={post.coverThumbAlt ?? post.title}
            width="600"
            height="335"
            decoding="async"
          />
          <figcaption>
            {post.coverThumbCredit ?? 'Official project image'}
            {post.coverThumbSource && (
              <>
                {' · '}
                <a href={post.coverThumbSource} target="_blank" rel="noopener">View upstream source ↗</a>
              </>
            )}
          </figcaption>
        </figure>
      )}

      <div class="post-content" set:html={post.content} />

      {post.videos && post.videos.length > 0 && (
        <section class="post-videos" aria-label="Official demo videos">
          <h2>Watch the official demos</h2>
          <p class="post-videos-intro">
            These are embedded from the projects' own channels and documentation. We store
            the URL only — no video file is downloaded or re-hosted here.
          </p>
          <div class="video-grid">
            {post.videos.map((video) => <VideoEmbed video={video} />)}
          </div>
        </section>
      )}

      <footer class="post-footer">
        <aside class="post-sources" aria-label="Sources and freshness" style="margin: 0 0 24px; padding: 16px 20px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface-2);">
          <h2 style="font-size: 16px; margin: 0 0 8px;">Where this guide's data comes from</h2>
          <p style="margin: 0; font-size: 14px; line-height: 1.7; color: var(--text-muted);">
            The profiles linked above are compiled from each project's official README,
            documentation, release notes and pricing page. Version numbers shown on those profiles
            come from a GitHub REST API snapshot checked on <strong>{VERSION_CHECKED}</strong>;
            they are not a live feed. All listing data is public in the
            <a href="https://github.com/102896351/Agents" target="_blank" rel="noopener">repository</a>.
            Verdicts here are editorial judgement based on public information, not measured test results.
          </p>
        </aside>

        {linkedAgents.length > 0 && (
          <nav class="inline-links" aria-label="Agents covered in this guide">
            <h2>Agents covered in this guide</h2>
            <div class="inline-link-row">
              {linkedAgents.map((a) => (
                <a href={`${base}/agent/${a.slug}/`}>{a.name}</a>
              ))}
            </div>
            <p>
              Compare every <a href={`${base}/category/${primaryCat.id}/`}>{primaryCat.label} agent</a>,
              or read more <a href={`${base}/blog/tags/${topics[0]}/`}>#{topics[0]} guides</a>.
            </p>
          </nav>
        )}

        <!-- Project bio: honest attribution, no invented editorial staff -->
        <aside class="author-bio" aria-label="About this project">
          <div class="author-avatar" aria-hidden="true">AH</div>
          <div class="author-body">
            <div class="author-name">AI Agents Hub</div>
            <div class="author-role">Independent open-source directory</div>
            <p class="author-text">
              AI Agents Hub is a one-developer project. Profiles are compiled from
              public sources into a consistent format, so the
              <a href={`${base}/`}>{agents.length} agents in the directory</a> can be
              compared side by side. Verdicts and pick-if / skip-if notes are editorial
              judgement, not hands-on test results; sample inputs and outputs are
              illustrative examples. All listing data lives in a
              <a href="https://github.com/102896351/Agents" target="_blank" rel="noopener">public repository</a>.
            </p>
            <p class="author-cta">
              Spotted an error? <a href="https://github.com/102896351/Agents/issues" target="_blank" rel="noopener">Open an issue or send a PR</a> ·
              Read <a href={`${base}/about/#how-profiles-are-written`}>how profiles are written</a>.
            </p>
          </div>
        </aside>
      </footer>
    </div>
  </article>

  {related.length > 0 && (
    <section class="related">
      <div class="container">
        <h2>More from the blog</h2>
        <div class="related-grid">
          {related.map((p) => (
            <a href={`${base}/blog/${p.slug}/`} class="related-card">
              <div class="related-meta">
                <time datetime={p.date}>{new Date(p.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</time>
                <span class="dot">·</span>
                <span>{p.readingTime} min</span>
              </div>
              <h3>{p.title}</h3>
              <p>{p.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style is:global>
  .post {
    padding: 60px 0 40px;
  }
  .post-header {
    margin: 0 0 40px;
  }
  .back-link {
    display: inline-block;
    color: var(--text-muted);
    font-size: 14px;
    text-decoration: none;
    margin-bottom: 24px;
  }
  .back-link:hover {
    color: var(--text);
  }
  .post-header h1 {
    font-size: 44px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .post-excerpt {
    color: var(--text-muted);
    font-size: 18px;
    line-height: 1.6;
    margin: 0 0 20px;
  }
  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 14px;
    color: var(--text-muted);
  }
  .post-meta .dot {
    color: var(--border);
  }
  .post-hero-figure {
    margin: 0 0 26px;
  }
  .post-hero-figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface-2);
  }
  .post-hero-figure figcaption {
    margin-top: 8px;
    font-size: 12px;
    color: var(--text-muted);
  }
  .post-hero-figure figcaption a { color: #818cf8; }
  .post-videos { margin: 34px 0 10px; }
  .post-videos h2 {
    margin: 0 0 8px;
    font-size: 24px;
    color: var(--text);
  }
  .post-videos-intro {
    margin: 0 0 6px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .post-videos .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin-top: 16px;
  }
  .post-videos .video-embed { margin: 0; }
  .post-videos .video-title {
    margin: 0 0 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }
  .post-videos .video-frame {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface);
  }
  .post-videos .video-frame video {
    display: block;
    width: 100%;
    height: auto;
    max-height: 420px;
  }
  .post-videos .video-frame--iframe { aspect-ratio: 16 / 9; }
  .post-videos .video-frame--iframe iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .post-videos .video-embed figcaption {
    margin-top: 8px;
    font-size: 12px;
    color: var(--text-muted);
  }
  .post-videos .video-embed figcaption a { color: #818cf8; }
  .post-content {
    font-size: 17px;
    line-height: 1.75;
    color: var(--text);
  }
  .post-content h2 {
    font-size: 28px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 48px 0 16px;
  }
  .post-content h2:first-child {
    margin-top: 0;
  }
  .post-content p {
    margin: 0 0 20px;
  }
  .post-content strong {
    font-weight: 600;
  }
  .post-content a {
    color: #818cf8;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .post-content code {
    background: var(--surface-2);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: 'SF Mono', Menlo, Consolas, monospace;
  }
  .post-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 15px;
  }
  .post-content figure {
    margin: 32px 0;
  }
  .post-content figure img {
    width: 100%;
    height: auto;
    border-radius: 14px;
    display: block;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
  }
  .post-content figcaption {
    font-size: 14px;
    color: var(--text-muted);
    text-align: center;
    margin-top: 12px;
    font-style: italic;
    line-height: 1.5;
    padding: 0 16px;
  }
  .post-content th,
  .post-content td {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .post-content th {
    font-weight: 600;
    color: var(--text);
    background: var(--surface-2);
  }
  .post-content tbody tr:last-child td {
    border-bottom: none;
  }
  .post-footer {
    margin: 48px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .post-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
  }
  .post-topics a {
    display: inline-block;
    padding: 4px 12px;
    font-size: 12px;
    color: var(--text-muted);
    background: var(--surface-2);
    border-radius: 999px;
    text-decoration: none;
  }
  .post-topics a:hover {
    color: #818cf8;
  }
  .post-context {
    margin: 14px 0 0;
    font-size: 13px;
    color: var(--text-muted);
  }
  .post-context a {
    color: #818cf8;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .inline-links {
    margin-bottom: 32px;
  }
  .inline-links h2 {
    font-size: 20px;
    margin: 0 0 12px;
  }
  .inline-link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }
  .inline-link-row a {
    font-size: 13px;
    padding: 6px 13px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
  }
  .inline-link-row a:hover {
    border-color: #818cf8;
    color: #818cf8;
  }
  .inline-links p {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0;
  }
  .inline-links p a {
    color: #818cf8;
  }
  .author-bio {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-top: 32px;
    padding: 20px 24px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .author-avatar {
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6366f1, #818cf8);
    color: #fff;
    font-size: 20px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .author-body {
    flex: 1;
    min-width: 0;
  }
  .author-name {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }
  .author-role {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 8px;
  }
  .author-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text);
    margin: 0 0 8px;
  }
  .author-text a {
    color: #818cf8;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .author-cta {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0;
  }
  .author-cta a {
    color: #818cf8;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .related {
    padding: 40px 0 80px;
    background: var(--surface-2);
  }
  .related h2 {
    font-size: 24px;
    margin: 0 0 20px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }
  .related-card {
    display: block;
    padding: 20px 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .related-card:hover {
    border-color: var(--accent, #6366f1);
  }
  .related-card h3 {
    font-size: 16px;
    line-height: 1.35;
    margin: 8px 0 8px;
  }
  .related-card p {
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-meta {
    display: flex;
    gap: 6px;
    font-size: 12px;
    color: var(--text-muted);
  }
  .related-meta .dot {
    color: var(--border);
  }
</style>

---
import '../styles/global.css';
import { agents, categories } from '../data/agents';

const { title, description, noAds = false, noIndex = false, preloadImage } = Astro.props as {
  title?: string;
  description?: string;
  noAds?: boolean; // 404 / error pages: skip AdSense to comply with "no ads on screens without publisher content"
  noIndex?: boolean; // 404 / error pages: never let a missing URL be indexed as a page
  preloadImage?: string; // above-the-fold LCP image: fetch it earlier instead of waiting for the parser
};

const siteName = 'AI Agents Hub';
const finalTitle = title ? `${title} · ${siteName}` : `${siteName} — A curated directory of AI agents`;
const finalDesc =
  description ||
  'Discover, compare, and choose AI agents for coding, research, browsing, automation, and more. Structured profiles built from public sources, with pick-if / skip-if verdicts.';
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').toString();
// 动态读取 base 路径，避免硬编码（适配自定义域名 vs github.io/仓库名）
const B = import.meta.env.BASE_URL; // 末尾带 /，如 '/' 或 '/Agents/'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${B}favicon.svg`} />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDesc} />
    {!noIndex && <link rel="canonical" href={canonical} />}

    <!-- Hreflang: site content is English-only. Declare x-default + en.
         Do NOT declare other languages until real translated content exists
         (fake multilingual hreflang is a Google quality penalty). -->
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />

    <!-- RSS: guides and directory updates -->
    <link rel="alternate" type="application/rss+xml" title="AI Agents Hub guides" href={`${B}rss.xml`} />

    <!-- Preload the above-the-fold LCP image (blog cover) so the browser fetches it
         while still parsing CSS/JS instead of discovering it below the header. -->
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <!-- SEO: explicit indexing directives -->
    <meta name="robots" content={noIndex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="googlebot" content={noIndex ? 'noindex, follow' : 'index, follow'} />
    <meta name="author" content="AI Agents Hub" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#6366f1" />

    <!-- Open Graph -->
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="AI Agents Hub" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDesc} />

    <!-- Hint to browsers: this site works with or without JS -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Google Search Console 域名验证 -->
    <meta name="google-site-verification" content="ovq9r0v0CQvoRVpYkidLESCpbwRLyqo32IZgVD3Yt0Y" />

    <!-- Google AdSense (skipped on noAds pages to comply with "no ads on screens without publisher content") -->
    {!noAds && (
      <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1606763409380030"
        crossorigin="anonymous"
      ></script>
    )}

    <!-- Google Analytics (GA4) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-GEVLL2XDFD"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag() { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', 'G-GEVLL2XDFD');
    </script>

    <!-- JSON-LD: 让搜索引擎把列表理解成目录结构 -->
    {agents.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://www.schema.org',
          '@type': 'ItemList',
          name: 'AI Agents Hub — A curated directory of AI agents',
          description: finalDesc,
          url: 'https://gonglue.xyz/',
          numberOfItems: agents.length,
          itemListElement: agents.map((a, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: a.name,
            url: `https://gonglue.xyz/agent/${a.slug}`,
            description: a.tagline,
          })),
        })}
      />
    )}

    <!-- JSON-LD: WebSite + SearchAction for sitelinks search box -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://www.schema.org',
        '@type': 'WebSite',
        name: 'AI Agents Hub',
        url: 'https://gonglue.xyz/',
        description: finalDesc,
        inLanguage: 'en',
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: 'https://gonglue.xyz/?q={search_term_string}',
          },
          'query-input': 'required name=search_term_string',
        },
      })}
    />

    <!-- 页面级 head 内容插槽（如详情页的 SoftwareApplication JSON-LD）-->
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href={B} class="brand">
          <img src={`${B}favicon.svg`} alt="" />
          AI Agents Hub
        </a>
        <nav class="nav">
          <a href={`${B}best-coding-agents/`}>Coding</a>
          <a href={`${B}#categories`}>Categories</a>
          <a href={`${B}#featured`}>Featured</a>
          <a href={`${B}blog`}>Blog</a>
          <a href={`${B}about`}>About</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-cols">
          <div>
            <a href={B} class="footer-brand-link">AI Agents Hub</a>
            <p class="footer-blurb">
              An independent open-source directory of {agents.length} AI agents.
              Profiles are compiled from public sources; the data is open to
              corrections on <a href="https://github.com/102896351/Agents" target="_blank" rel="noopener">GitHub</a>.
            </p>
          </div>
          <div>
            <h4>Directory</h4>
            {categories.map((c) => (
              <a href={`${B}category/${c.id}/`}>{c.label} agents</a>
            ))}
          </div>
          <div>
            <h4>Guides</h4>
            <a href={`${B}best-coding-agents/`}>Best coding agents</a>
            <a href={`${B}blog/`}>All guides</a>
            <a href={`${B}blog/tags/comparison/`}>Comparisons</a>
            <a href={`${B}blog/tags/mcp-tooling/`}>MCP &amp; tooling</a>
          </div>
          <div>
            <h4>Project</h4>
            <a href={`${B}about/`}>About</a>
            <a href={`${B}contact/`}>Contact &amp; corrections</a>
            <a href={`${B}privacy/`}>Privacy</a>
            <a href={`${B}disclaimer/`}>Disclaimer</a>
          </div>
        </div>
        <p class="footer-tagline">
          © 2026 AI Agents Hub · {agents.length} agents across {categories.length} categories ·
          An independent open-source project
        </p>
        <nav class="footer-nav footer-sites" aria-label="Related sites">
          <span class="footer-sites-label">Related sites:</span>
          <a href="https://toolbox168.xyz/" rel="nofollow noopener">QR Code Generator</a>
          <a href="https://toolbox168.com/" rel="nofollow noopener">Image Tools</a>
          <a href="https://aiartspell.art/" rel="nofollow noopener">AI Art Prompts</a>
          <a href="https://image.aiartspell.art/" rel="nofollow noopener">Free AI Photo Tools</a>
        </nav>
      </div>
    </footer>

    <!-- Anonymous, aggregate interaction events.
         No personal data, no search terms, no query strings, no new vendor,
         no localStorage / user IDs. See /privacy/ section 2. -->
    <script is:inline>
      (function () {
        var fired = {};
        var path = location.pathname.replace(/\/+$/, '') || '/';
        var group = path.indexOf('/agent/') === 0 ? 'agent'
                  : path.indexOf('/blog/') === 0 ? 'blog'
                  : path === '/' ? 'home' : 'other';
        var m = path.match(/^\/(?:agent|blog)\/([^/]+)\/?$/);
        var slug = m ? m[1] : '';

        function base(extra) {
          var p = { content_group: group, page_path: path };
          if (slug) p.content_slug = slug;
          if (extra) { for (var k in extra) p[k] = extra[k]; }
          return p;
        }
        function send(name, key, extra) {
          if (fired[key]) return;
          fired[key] = 1;
          try { window.gtag('event', name, base(extra)); } catch (e) {}
        }
        function markHuman(source) {
          if (document.visibilityState && document.visibilityState !== 'visible') return;
          send('real_reader', 'real_reader', { signal: source });
        }

        document.addEventListener('click', function (ev) {
          markHuman('click');
          var a = ev.target && ev.target.closest ? ev.target.closest('a[href]') : null;
          if (!a) return;
          var href = a.getAttribute('href') || '';
          if (!/^https?:\/\//i.test(href)) return;
          var host = '';
          try { host = new URL(href).hostname.replace(/^www\./, ''); } catch (e) { return; }
          var txt = (a.textContent || '').trim();
          var name = '';
          if (/github\.com$/i.test(host)) name = 'click_github';
          else if (/Visit website/i.test(txt) || a.classList.contains('primary')) name = 'click_official_site';
          else if (/View upstream source/i.test(txt)) name = 'click_source';
          if (!name) return;
          send(name, name + ':' + href, { link_host: host });
        }, false);

        document.addEventListener('toggle', function (ev) {
          var d = ev.target;
          if (d && d.tagName === 'DETAILS' && d.open) {
            send('faq_open', 'faq_open');
            markHuman('faq');
          }
        }, true);

        var ticking = false;
        function checkDepth() {
          ticking = false;
          var h = document.documentElement.scrollHeight || document.body.scrollHeight;
          var y = window.scrollY || window.pageYOffset || 0;
          var seen = y + window.innerHeight;
          if (h > 0 && seen >= h * 0.5) {
            send('scroll_50', 'scroll_50', { depth: 50 });
            markHuman('scroll');
          }
          if (h > 0 && seen >= h * 0.9) send('read_to_bottom', 'read_to_bottom', { depth: 100 });
        }
        window.addEventListener('scroll', function () {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(checkDepth);
        }, { passive: true });

        var searchInput = document.getElementById('search');
        if (searchInput) {
          searchInput.addEventListener('input', function () {
            if ((this.value || '').trim().length >= 2) {
              send('site_search', 'site_search');
              markHuman('search');
            }
          });
        }
      })();
    </script>
  </body>
</html>
